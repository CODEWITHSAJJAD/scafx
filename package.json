{
  "name": "project-scaffolder-monorepo",
  "version": "0.3.0",
  "private": true,
  "description": "Universal project scaffolder CLI",
  "scripts": {
    "build": "pnpm -r build",
    "test": "vitest run",
    "test:unit": "vitest run --exclude \"**/*.smoke.test.ts\"",
    "test:smoke": "vitest run smoke.test",
    "lint": "eslint .",
    "scaffold": "node packages/cli/bin/run.js",
    "format": "prettier --check \"**/*.{ts,js,json,md,yaml,yml}\"",
    "format:fix": "prettier --write \"**/*.{ts,js,json,md,yaml,yml}\""
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "@types/node": "^22.13.10",
    "eslint": "^9.22.0",
    "prettier": "^3.5.3",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.26.0",
    "vitest": "^3.0.8"
  }
}
